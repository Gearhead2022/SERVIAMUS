--- a/frontend/utils/patient-chart-file.ts
+++ b/frontend/utils/patient-chart-file.ts
@@
+export const resolvePatientChartMimeType = (mimeType, fileName) => {
+  // Accept PDF/JPG/JPEG/PNG only. Use a safe filename-extension fallback for
+  // scanner software that reports an empty or application/octet-stream MIME.
+};

--- a/frontend/services/patient-chart.services.ts
+++ b/frontend/services/patient-chart.services.ts
@@ uploadPatientChartAttachment
