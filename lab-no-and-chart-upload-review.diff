--- a/backend/src/modules/patient-chart/patient-chart.upload.ts
+++ b/backend/src/modules/patient-chart/patient-chart.upload.ts
@@
+// New dedicated binary-body parser for patient-chart uploads.
+// It accepts the request body before the application's global JSON parser.
+export const patientChartUploadBodyParser = express.raw({
+  type: () => true,
+  limit: "10mb",
+});

--- a/backend/src/server.ts
+++ b/backend/src/server.ts
@@ parser order
 app.use(cookieParser());
+app.use("/api/patient-chart/attachments", patientChartUploadBodyParser);
 app.use(express.json());

